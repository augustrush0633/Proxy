#!name=V2EX 每日签到
#!desc=V2EX 每日签到领取铜币
#!author=Curtinp118
#!homepage=https://github.com/curtinp118/Loon
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/V2ex.png
#!tag=Check-in

[Argument]
v2ex_enable=swirch,"true","false",tag=V2EX抓包开关, desc=是否开启V2EX抓包
CRONEXP=input,"0 9 * * *",tag=Crontab表达式, desc=推荐地址: "https://www.bejson.com/othertools/cron/"
timeout=input,"60",tag=脚本运行最大时间, desc=脚本运行最大时间

[Rewrite]
^https://www\.v2ex\.com/(mission|member).* url script-request-header https://raw.githubusercontent.com/curtinp118/Scripthub/main/scripts/v2ex/v2ex.js

[Script]
http-request ^https://www\.v2ex\.com/(mission|member).*$ script-path=https://raw.githubusercontent.com/curtinp118/Scripthub/main/scripts/v2ex/v2ex.js, requires-body=false, timeout=10, tag=V2EX抓包, enable={v2ex_enable}
cron {CRONEXP} script-path=https://raw.githubusercontent.com/curtinp118/Scripthub/main/scripts/v2ex/v2ex.js, timeout={timeout}, tag=V2EX签到
[MITM]
hostname = www.v2ex.com
